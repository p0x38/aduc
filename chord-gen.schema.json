{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/chord-gen.schema.json",
    "title": "Chord Generation Record",
    "description": "A prompt and structured musical output record.",
    "type": "object",
    "required": [
        "prompt",
        "output"
    ],
    "additionalProperties": false,
    "properties": {
        "prompt": {
            "type": "string",
            "description": "Instruction describing the desired musical output."
        },
        "output": {
            "$ref": "#/$defs/output"
        }
    },
    "$defs": {
        "output": {
            "type": "object",
            "required": [
                "metadata",
                "shared",
                "progression_data"
            ],
            "additionalProperties": false,
            "properties": {
                "metadata": {
                    "$ref": "#/$defs/metadata"
                },
                "shared": {
                    "type": "object",
                    "description": "Named reusable musical structures.",
                    "additionalProperties": {
                        "$ref": "#/$defs/chordGroup"
                    }
                },
                "progression_data": {
                    "type": "array",
                    "description": "The progression, consisting of chords, chord groups, and shared references.",
                    "items": {
                        "$ref": "#/$defs/chordItem"
                    }
                }
            }
        },
        "metadata": {
            "type": "object",
            "description": "Metadata describing the musical output.",
            "required": [
                "bpm",
                "signature",
                "scale"
            ],
            "additionalProperties": false,
            "properties": {
                "bpm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Tempo in beats per minute."
                },
                "signature": {
                    "type": "array",
                    "description": "Time signature represented as [numerator, denominator].",
                    "prefixItems": [
                        {
                            "type": "integer",
                            "minimum": 1
                        },
                        {
                            "type": "integer",
                            "minimum": 1
                        }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                },
                "scale": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Musical scale or mode, such as C major or A Dorian."
                }
            }
        },
        "chordItem": {
            "type": "object",
            "description": "A chord, chord group, or reference to shared data.",
            "oneOf": [
                {
                    "$ref": "#/$defs/chord"
                },
                {
                    "$ref": "#/$defs/chordGroup"
                },
                {
                    "$ref": "#/$defs/sharedReference"
                }
            ]
        },
        "chord": {
            "type": "object",
            "required": [
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Chord symbol, such as Cm7 or DbM7."
                }
            }
        },
        "chordGroup": {
            "type": "object",
            "required": [
                "chords"
            ],
            "additionalProperties": false,
            "description": "A progression unit containing multiple chords divided into equal subdivisions.",
            "properties": {
                "chords": {
                    "type": "array",
                    "description": "Chords occupying equal subdivisions of the progression unit.",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/chord"
                    }
                }
            }
        },
        "sharedReference": {
            "type": "object",
            "description": "A reference to a named reusable musical structure.",
            "required": [
                "shared"
            ],
            "additionalProperties": false,
            "properties": {
                "shared": {
                    "type": "string",
                    "pattern": "^\\$[A-Za-z_][A-Za-z0-9_-]*$",
                    "description": "Reference to a named shared structure, prefixed with '$'."
                }
            }
        }
    }
}